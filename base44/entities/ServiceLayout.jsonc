{
  "name": "ServiceLayout",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Soci\u00e9t\u00e9"
    },
    "page_format": {
      "type": "string",
      "title": "Format de page",
      "enum": [
        "A4-portrait",
        "A4-paysage",
        "A3-portrait",
        "A3-paysage"
      ],
      "default": "A3-paysage"
    },
    "positions": {
      "type": "array",
      "title": "Positions des blocs",
      "items": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "company_id"
  ]
}