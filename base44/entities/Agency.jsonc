{
  "name": "Agency",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Soci\u00e9t\u00e9"
    },
    "name": {
      "type": "string",
      "title": "Nom de l'agence"
    },
    "zone": {
      "type": "string",
      "title": "Zone g\u00e9ographique"
    },
    "city": {
      "type": "string",
      "title": "Ville"
    },
    "department_code": {
      "type": "string",
      "title": "D\u00e9partement"
    },
    "email": {
      "type": "string",
      "title": "Email agence"
    },
    "phone": {
      "type": "string",
      "title": "T\u00e9l\u00e9phone"
    },
    "address": {
      "type": "string",
      "title": "Adresse"
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    }
  },
  "required": [
    "name",
    "zone",
    "city"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.company_id": {
            "$in": "{{user.data.accessible_company_ids}}"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.company_id": {
            "$in": "{{user.data.accessible_company_ids}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.company_id": {
            "$in": "{{user.data.accessible_company_ids}}"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.company_id": {
            "$in": "{{user.data.accessible_company_ids}}"
          }
        }
      ]
    }
  }
}