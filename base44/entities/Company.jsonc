{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nom de la soci\u00e9t\u00e9"
    },
    "logo_url": {
      "type": "string",
      "title": "Logo",
      "format": "uri"
    },
    "brand_color": {
      "type": "string",
      "title": "Couleur principale",
      "default": "#003D7A"
    },
    "services": {
      "type": "array",
      "title": "Services",
      "items": {
        "type": "string"
      }
    },
    "statuses": {
      "type": "array",
      "title": "Statuts collaborateur",
      "items": {
        "type": "string"
      }
    },
    "zones": {
      "type": "array",
      "title": "Zones g\u00e9ographiques",
      "items": {
        "type": "string"
      }
    },
    "anciennes_entites": {
      "type": "array",
      "title": "Anciennes entit\u00e9s",
      "items": {
        "type": "string"
      }
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "id": {
            "$in": "{{user.data.accessible_company_ids}}"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}