{
  "name": "OrgSnapshot",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Société"
    },
    "label": {
      "type": "string",
      "title": "Libellé de l'archive"
    },
    "source": {
      "type": "string",
      "title": "Origine",
      "enum": [
        "pre_edit",
        "manual",
        "pre_restore"
      ],
      "description": "pre_edit = créée automatiquement avant une modification via le lien direction ; manual = créée à la demande par la RH ; pre_restore = créée automatiquement juste avant une restauration.",
      "default": "manual"
    },
    "created_via": {
      "type": "string",
      "title": "Créée par",
      "description": "Origine humaine : 'lien-direction' ou 'rh'.",
      "default": "rh"
    },
    "employee_count": {
      "type": "number",
      "title": "Nombre de collaborateurs",
      "default": 0
    },
    "data": {
      "type": "string",
      "title": "Données de l'archive (JSON)",
      "description": "Instantané JSON de l'organigramme : rattachements, services, libellés, ordre de tri et positions des blocs."
    }
  },
  "required": [
    "company_id",
    "data"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "rh"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "rh"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "rh"
          }
        }
      ]
    }
  }
}
