{
  "name": "Employee",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Soci\u00e9t\u00e9"
    },
    "first_name": {
      "type": "string",
      "title": "Pr\u00e9nom"
    },
    "last_name": {
      "type": "string",
      "title": "Nom"
    },
    "position": {
      "type": "string",
      "title": "Poste"
    },
    "position_constructeur": {
      "type": "string",
      "title": "Poste (intitul\u00e9 constructeur)"
    },
    "service": {
      "type": "string",
      "title": "Service"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "T\u00e9l\u00e9phone"
    },
    "photo_url": {
      "type": "string",
      "title": "Photo",
      "format": "uri"
    },
    "agency_id": {
      "type": "string",
      "title": "Agence"
    },
    "ancienne_entite": {
      "type": "string",
      "title": "Ancienne entit\u00e9"
    },
    "zone": {
      "type": "string",
      "title": "Zone g\u00e9ographique"
    },
    "manager_id": {
      "type": "string",
      "title": "Manager direct"
    },
    "status": {
      "type": "string",
      "title": "Statut",
      "default": "Actif"
    },
    "hire_date": {
      "type": "string",
      "title": "Date d'entr\u00e9e",
      "format": "date"
    },
    "departure_date": {
      "type": "string",
      "title": "Date de d\u00e9part",
      "format": "date"
    },
    "notes": {
      "type": "string",
      "title": "Notes RH"
    },
    "is_group_support": {
      "type": "boolean",
      "title": "Support Groupe",
      "default": false
    },
    "is_co_manager": {
      "type": "boolean",
      "title": "Co-manager",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "title": "Ordre de tri vertical",
      "default": 0
    }
  },
  "required": [
    "first_name",
    "last_name",
    "position"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "rh"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "rh"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "rh"
          }
        }
      ]
    }
  }
}