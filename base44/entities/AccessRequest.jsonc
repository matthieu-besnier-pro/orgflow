{
  "name": "AccessRequest",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "title": "Email du demandeur"
    },
    "user_name": {
      "type": "string",
      "title": "Nom du demandeur"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "status": {
      "type": "string",
      "title": "Statut",
      "enum": [
        "En attente",
        "Trait\u00e9e"
      ],
      "default": "En attente"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}